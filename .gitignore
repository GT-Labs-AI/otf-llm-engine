# Виртуальное окружение Python
.venv/
venv/
env/
ENV/

# Кэш Python и компилированные файлы
__pycache__/
*.py[cod]
*$py.class

# Тяжелые веса моделей, профили и чекпоинты (не загружаются на GitHub)
*.pt
*.safetensors
*.bin
*.pth
*.ckpt
*.onnx

# Конфигурации и кэш IDE / Редакторов кода
.vscode/
.idea/
*.swp
*.swo

# Системные файлы Windows и macOS
Thumbs.db
Desktop.ini
.DS_Store

# Логи и временные файлы
*.log
*.tmp